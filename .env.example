# Opportunity Intelligence Agent — environment configuration
#
# Copy to .env and adjust. Nested settings use a double underscore:
#   DATABASE__POOL_SIZE=20  ->  settings.database.pool_size
#
# Generate a production secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------- application
ENVIRONMENT=development           # development | test | staging | production
DEBUG=false
GIT_SHA=unknown

# ------------------------------------------------------------------ database
# Inside Docker Compose the host is "postgres"; from the host it is "localhost".
DATABASE__URL=postgresql+asyncpg://oia:oia@localhost:5432/oia
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20

# ------------------------------------------------------------------ security
# REQUIRED in staging/production; the application refuses to start without it.
SECURITY__SECRET_KEY=change-me-in-production
SECURITY__ACCESS_TOKEN_TTL_MINUTES=30
SECURITY__REFRESH_TOKEN_TTL_DAYS=14
SECURITY__PASSWORD_MIN_LENGTH=12
SECURITY__RATE_LIMIT_ENABLED=true
SECURITY__RATE_LIMIT_REQUESTS=120
SECURITY__RATE_LIMIT_WINDOW_S=60
SECURITY__AUTH_RATE_LIMIT_REQUESTS=10

# ---------------------------------------------------------------------- CORS
# Comma-separated. A wildcard is rejected outside development.
CORS__ALLOW_ORIGINS=http://localhost:3000

# --------------------------------------------------------------------- redis
REDIS__ENABLED=false
REDIS__URL=redis://localhost:6379/0

# ----------------------------------------------------------------------- RAG
# embedding_dim must match the migrated schema (768). Changing it needs a
# migration and a re-embed, not just an environment variable.
RAG__EMBEDDING_PROVIDER=ollama
RAG__EMBEDDING_MODEL=nomic-embed-text
RAG__EMBEDDING_DIM=768
RAG__VECTOR_STORE=pgvector
RAG__RERANK_ENABLED=true

# -------------------------------------------------------------------- models
MODELS__PROVIDER=ollama
MODELS__BASE_URL=http://localhost:11434
MODELS__MODEL_SMALL=qwen2.5:3b-instruct
MODELS__MODEL_STANDARD=qwen2.5:7b-instruct
MODELS__MODEL_REASONING=qwen2.5:14b-instruct
MODELS__MODEL_EXTRACTION=qwen2.5:7b-instruct

# -------------------------------------------------------------------- agents
AGENTS__MAX_ITERATIONS=3
AGENTS__MAX_TOOL_CALLS_TOTAL=60
AGENTS__MAX_CANDIDATES_RESEARCHED=15
AGENTS__MAX_WALL_CLOCK_S=600
AGENTS__MAX_COST_USD=1.0

# ------------------------------------------------------------- observability
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_FORMAT=console     # json in production
OBSERVABILITY__OTEL_ENABLED=false
OBSERVABILITY__OTEL_ENDPOINT=http://localhost:4317
# OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
# OBSERVABILITY__LANGFUSE_SECRET_KEY=
# OBSERVABILITY__MLFLOW_TRACKING_URI=http://localhost:5000

# ------------------------------------------------------------------ frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------ docker compose (postgres service)
POSTGRES_USER=oia
POSTGRES_PASSWORD=oia
POSTGRES_DB=oia
